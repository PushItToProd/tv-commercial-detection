LLAMA_PORT=3002

MODELS_HOST_DIR=/mnt/data/llm-models

## Model and mmproj file names (paths should be relative to MODELS_HOST_DIR)
## 4B
#MODEL_FILE=Qwen3.5-4B-Q4_K_M/Qwen3.5-4B-Q4_K_M.gguf
#MMPROJ_FILE=Qwen3.5-4B-BF16/Qwen3.5-4B-GGUF-mmproj-BF16.gguf
#LLAMA_EXTRA_ARGS=-c 50000 -b 4096 --ubatch-size 4096 -np 2 --kv-unified --cache-ram 1000 --verbose

# Qwen3-Omni supports accepting both images and audio for classification and
# seems to have somewhat higher accuracy while still being fast (since it's MoE)
MODEL_FILE=Qwen3-Omni-30B-A3B-Instruct-Q4_K_M/Qwen3-Omni-30B-A3B-Instruct-Q4_K_M.gguf
MMPROJ_FILE=Qwen3-Omni-30B-A3B-Instruct-Q4_K_M/mmproj-Qwen3-Omni-30B-A3B-Instruct-Q8_0.gguf
# LLAMA_EXTRA_ARGS=-c 20000 -ctk q4_0 -ctv q4_0 --no-mmap -np 2 --kv-unified --cache-ram 1000
LLAMA_EXTRA_ARGS=-ngl all -c 8192 -b 2048 -ub 2048 -np 2 --kv-unified -fa on --no-context-shift

HDMI_MATRIX_CONTROL_DIR=$HOME/Code/projects/portta-multiviewer-control
HDMI_MATRIX_CONTROL_PORT=11344
HDMI_MATRIX_SERIAL_PORT=/dev/ttyACM0

RECEIVER_DIR=./server
RECEIVER_ENABLE_DEBOUNCE=1
RECEIVER_PORT=11679
